DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=database
DB_USERNAME=username
DB_PASSWORD=password
MAIL_URL=url
SITE_URL=url
# true apenas em desenvolvimento (expõe detalhes de erro e o OTP na resposta)
DEVELOPMENT_ENV=false
# Origem permitida no CORS, ex.: https://vehoute.exemplo.com
CORS_ORIGIN=*
# true somente se houver um proxy reverso próprio na frente do PHP
TRUST_PROXY=false
